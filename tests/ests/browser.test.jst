import {chromium} from 'playwright';import http from 'node:http';import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';
let root=path.resolve('.');const server=http.createServer((req,res)=>{let p=path.join(root,decodeURIComponent(req.url.split('?')[0]==='/'?'/index.html':req.url.split('?')[0]));if(!p.startsWith(root)||!fs.existsSync(p)){res.writeHead(404).end();return}res.setHeader('Content-Type',p.endsWith('.js')?'text/javascript':p.endsWith('.css')?'text/css':'text/html');res.end(fs.readFileSync(p))});await new Promise(r=>server.listen(8765,r));const browser=await chromium.launch({executablePath:'/usr/bin/google-chrome',headless:true,args:['--no-sandbox']});let context=await browser.newContext({viewport:{width:1440,height:1000}}),page=await context.newPage();let errors=[];page.on('pageerror',e=>{errors.push(e.message);console.error('PAGE ERROR',e.message)});await page.goto('http://localhost:8765');await page.locator('#startDialog[open]').waitFor();await page.screenshot({path:'docs/start.png'});await page.locator('#createHero').click();await page.waitForFunction(()=>document.querySelector('#hero').textContent.includes('레벨 2'),{timeout:30000});await page.screenshot({path:'docs/adventure.png'});await page.locator('#pauseTop').click();await page.locator('#settingsDialog[open]').waitFor({timeout:10000});assert.equal(await page.locator('[data-delegate]:checked').count(),7);assert.equal(await page.locator('.menu-fields select:enabled').count(),0);await page.locator('[data-delegate="C"]').uncheck();await page.locator('[data-k="C"][data-key="direction"]').selectOption('수집');await page.locator('[data-delegate="C"]').check();await page.locator('[data-delegate="C"]').uncheck();assert.equal(await page.locator('[data-k="C"][data-key="direction"]').inputValue(),'수집');await page.screenshot({path:'docs/settings.png'});await page.locator('[data-delegate="C"]').check();await page.locator('#resumeBtn').click();await page.waitForFunction(()=>document.querySelector('#saveStatus').textContent.includes('완료'));let save=await page.evaluate(()=>localStorage.getItem('afk-ide.v1'));assert(save&&!save.includes('아르덴'));await page.reload();await page.waitForFunction(()=>document.querySelector('#hero').textContent.includes('아르덴'));assert(!errors.length,errors.join('\n'));console.log('Desktop UI PASS: level up, combat, pause, delegation restore, encrypted autosave, reload');
for(const width of [390,320]){await page.setViewportSize({width,height:844});if(!await page.locator('#settingsDialog').evaluate(e=>e.open))await page.locator('#pauseBottom').click();await page.locator('#settingsDialog[open]').waitFor({timeout:10000});let overflow=await page.evaluate(()=>({body:document.documentElement.scrollWidth>innerWidth,dialog:document.querySelector('#settingsDialog').scrollWidth>document.querySelector('#settingsDialog').clientWidth+2}));assert(!overflow.body&&!overflow.dialog,JSON.stringify(overflow));await page.screenshot({path:`docs/mobile-settings-${width}.png`});await page.locator('#resumeBtn').click();for(const v of ['hero','adventure','combat','bag']){await page.locator('.mobile-nav [data-view="'+v+'"]').click();assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));if(width===390)await page.screenshot({path:`docs/mobile-${v}.png`})}console.log('Mobile',width,'PASS');}
await browser.close();server.close();
